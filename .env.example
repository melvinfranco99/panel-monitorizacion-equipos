# Copia este fichero como .env y cambia los valores.
# ---------------------------------------------------
# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Usuario y contraseña del administrador
MONITOR_ADMIN_USUARIO=admin
MONITOR_ADMIN_PASSWORD=cambia-esta-contraseña

# Segundos entre comprobaciones y espera máxima de cada ping
MONITOR_INTERVALO=30
MONITOR_TIMEOUT=1
MONITOR_FALLOS_PARA_CAIDO=2
MONITOR_RETENCION_DIAS=30

# Ruta de la base de datos
MONITOR_DB=instance/monitor.db

# 1 = simula los resultados (para presentar sin red). 0 = red real
MONITOR_MODO_DEMO=0

# 1 = hay que iniciar sesión incluso para VER el panel (recomendado en empresa)
MONITOR_LOGIN_LECTURA=0

# Avisos por Telegram (opcional). Crea un bot con @BotFather.
MONITOR_TELEGRAM_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
